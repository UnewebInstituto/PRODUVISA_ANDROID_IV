<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.produvisa.emergencias">

    <!-- Permisos requeridos para la aplicación -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- IMPORTANTE: Para acceder a HTTPS desde el emulador con un certificado autofirmado (localhost),
         debemos permitir el tráfico HTTP de forma temporal o confiar en el certificado.
         Para simplificar el ejemplo, permitimos el tráfico claro, lo cual es común
         en entornos de desarrollo con localhost. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity android:name=".BienvenidaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SeleccionActivity" />
        <activity android:name=".CuestionarioActivity" />

    </application>
</manifest>